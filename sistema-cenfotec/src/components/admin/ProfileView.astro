---
// Importa los íconos usados en la vista de detalle de un registro.
import { ArrowLeft, Mail, Pencil, Phone } from "@lucide/astro";

// Define los datos que la vista de perfil necesita para mostrar un detalle.
interface Props {
    backHref: string;
    title: string;
    subtitle: string;
    status: string;
    email?: string;
    phone?: string;
    facts: { label: string; value: string }[];
    sections: { title: string; items: { label: string; value: string }[] }[];
}

// Recibe la información del registro y calcula la clase visual según su estado.
const { backHref, title, subtitle, status, email, phone, facts, sections } = Astro.props;
const statusClass = `is-${status.toLowerCase()}`;
---

<section class="admin-shell" aria-labelledby="profile-title">
    <div class="admin-profile-hero">
        <a class="admin-ghost-action" href={backHref}>
            <ArrowLeft size={18} />
            Volver
        </a>

        <div class="admin-profile-main">
            <span class="admin-profile-avatar">{title.slice(0, 1)}</span>
            <div>
                <h2 id="profile-title">{title}</h2>
                <p>{subtitle}</p>
                <span class:list={["admin-status", statusClass]}>{status}</span>
            </div>
        </div>

        <button class="admin-primary-action" type="button">
            <Pencil size={18} />
            Editar
        </button>
    </div>

    <div class="admin-profile-grid">
        <aside class="admin-profile-side">
            {email && (
                <a href={`mailto:${email}`}>
                    <Mail size={18} />
                    {email}
                </a>
            )}
            {phone && (
                <a href={`tel:${phone}`}>
                    <Phone size={18} />
                    {phone}
                </a>
            )}

            {facts.map((fact) => (
                <div>
                    <span>{fact.label}</span>
                    <strong>{fact.value}</strong>
                </div>
            ))}
        </aside>

        <div class="admin-profile-details">
            {sections.map((section) => (
                <section class="admin-detail-card">
                    <h3>{section.title}</h3>
                    <dl>
                        {section.items.map((item) => (
                            <>
                                <dt>{item.label}</dt>
                                <dd>{item.value}</dd>
                            </>
                        ))}
                    </dl>
                </section>
            ))}
        </div>
    </div>
</section>
