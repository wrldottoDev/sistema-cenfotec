---
import "../../styles/global.css"
import { Lock, LogIn, User } from "@lucide/astro"
---


<!-----
Componente del formulario de login
--- -->

<section class="login-card">
    <figure class="login-brand">
        <img src="/logos/logoletrasNoBG.png" alt="Logo de Universidad CENFOTEC">
    </figure>

    <div class="white-card">
        <div class="login-heading">
            <p>Bienvenido</p>
            <h1 class="title">Iniciar sesión</h1>
        </div>

        <form method="post" class="login-form">
            <label class="form-field">
                <span>Usuario</span>
                <div class="input-control">
                    <User size={20} />
                    <input type="text" name="usuario" placeholder="Ingrese su usuario">
                </div>
            </label>

            <label class="form-field">
                <span>Contraseña</span>
                <div class="input-control">
                    <Lock size={20} />
                    <input type="password" name="password" placeholder="Ingrese su contraseña">
                </div>
            </label>

            <div class="login-options">
                <label class="remember-option" for="recordarme">
                    <input type="checkbox" name="recordarme" id="recordarme" value="1">
                    <span>Recordarme</span>
                </label>

                <a href="#" class="links">¿Problemas para entrar?</a>
            </div>

            <button class="primary-button" type="submit">
                <LogIn size={20} />
                <span>Iniciar sesión</span>
            </button>
        </form>

        <p class="login-footer">
            <a href="#" class="links">Cambiar contraseña</a>
        </p>
    </div>
</section>
