---
// Importa los íconos usados en la barra superior del panel administrativo.
import { Bell, Moon, Search, Sun, UserRound } from "@lucide/astro";

// Define los textos configurables que muestra el encabezado de cada página.
interface Props {
    title?: string;
    subtitle?: string;
}

// Lee el título y subtítulo enviados por la página, con valores por defecto.
const { title = "Egresados", subtitle = "Gestión de egresados" } = Astro.props;
---

<header class="page-header">
    <div class="page-heading">
        <span class="page-kicker">Panel administrativo</span>
        <h1>{title}</h1>
        <p>{subtitle}</p>
    </div>

    <div class="header-actions">
        <label class="header-search">
            <Search size={20} />
            <input type="search" placeholder="Buscar" />
        </label>

        <button class="header-icon-button" type="button" aria-label="Ver notificaciones">
            <Bell size={20} />
        </button>

        <button class="theme-toggle" type="button" aria-label="Activar modo oscuro" aria-pressed="false">
            <span class="theme-toggle-track" aria-hidden="true">
                <span class="theme-toggle-thumb">
                    <Sun class="theme-icon theme-icon-sun" size={16} />
                    <Moon class="theme-icon theme-icon-moon" size={16} />
                </span>
            </span>
        </button>

        <button class="header-profile" type="button" aria-label="Abrir perfil">
            <span class="profile-avatar">
                <UserRound size={18} />
            </span>
            <span class="profile-copy">
                <strong>Admin</strong>
                <small>CENFOTEC</small>
            </span>
        </button>
    </div>
</header>

<script>
    // Controla el botón de tema y mantiene sincronizados sus textos accesibles.
    const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
    const root = document.documentElement;

    // Actualiza el estado visual y accesible del botón según el tema activo.
    const updateThemeToggle = () => {
        const isDark = root.dataset.theme === "dark";
        themeToggle?.setAttribute("aria-pressed", String(isDark));
        themeToggle?.setAttribute("aria-label", isDark ? "Activar modo claro" : "Activar modo oscuro");
    };

    updateThemeToggle();

    // Alterna entre modo claro y oscuro, y guarda la elección en el navegador.
    themeToggle?.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;
        localStorage.setItem("theme", nextTheme);
        updateThemeToggle();
    });
</script>
