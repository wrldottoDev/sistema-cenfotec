---
import {
    Award,
    BookOpen,
    ChevronLeft,
    GraduationCap,
    LayoutDashboard,
    LogOut,
    School,
    Settings,
} from "@lucide/astro";

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<nav class="sidebar is-collapsed" id="sidebar">
    <header>
        <div class="image-text">
            <span class="image">
                <img class="logo-full" src="/logos/logoletrasNoBG.png" alt="Universidad Cenfotec">
                <img class="logo-mark" src="/logos/logoNoBG.png" alt="Universidad Cenfotec">
            </span>
        </div>

        <button class="toggle" type="button" aria-label="Alternar menú lateral" aria-expanded="false">
            <ChevronLeft size={22} />
        </button>
    </header>

    <div class="menu-bar">
        <div class="menu">
            <ul class="menu-links">
                <li class:list={["nav-link", { "is-active": isActive("/dashboard") }]}>
                    <a href="/dashboard" aria-current={isActive("/dashboard") ? "page" : undefined}>
                        <LayoutDashboard size={28} />
                        <span class="text nav-text">Dashboard</span>
                    </a>
                </li>

                <li class:list={["nav-link", { "is-active": isActive("/egresados") }]}>
                    <a href="/egresados" aria-current={isActive("/egresados") ? "page" : undefined}>
                        <GraduationCap size={26} />
                        <span class="text nav-text">Gestión de Egresados</span>
                    </a>
                </li>

                <li class:list={["nav-link", { "is-active": isActive("/titulos") }]}>
                    <a href="/titulos" aria-current={isActive("/titulos") ? "page" : undefined}>
                        <Award size={26} />
                        <span class="text nav-text">Gestión de Títulos</span>
                    </a>
                </li>

                <li class:list={["nav-link", { "is-active": isActive("/carreras") }]}>
                    <a href="/carreras" aria-current={isActive("/carreras") ? "page" : undefined}>
                        <BookOpen size={26} />
                        <span class="text nav-text">Gestión de Carreras</span>
                    </a>
                </li>

                <li class:list={["nav-link", { "is-active": isActive("/escuelas") }]}>
                    <a href="/escuelas" aria-current={isActive("/escuelas") ? "page" : undefined}>
                        <School size={26} />
                        <span class="text nav-text">Gestión de Escuelas</span>
                    </a>
                </li>

                <li class:list={["nav-link", { "is-active": isActive("/configuraciones") }]}>
                    <a href="/configuraciones" aria-current={isActive("/configuraciones") ? "page" : undefined}>
                        <Settings size={26} />
                        <span class="text nav-text">Configuraciones</span>
                    </a>
                </li>

                <li class="nav-link">
                    <a href="/">
                        <LogOut size={26} />
                        <span class="text nav-text">Salir</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
    const sidebar = document.querySelector("#sidebar");
    const toggle = sidebar?.querySelector(".toggle");

    toggle?.addEventListener("click", () => {
        const isCollapsed = sidebar?.classList.toggle("is-collapsed");
        document.body.classList.toggle("sidebar-open", !isCollapsed);
        toggle.setAttribute("aria-expanded", String(!isCollapsed));
    });
</script>
