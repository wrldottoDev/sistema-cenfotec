    <script>
        const publicNav = document.querySelector(".public-nav");
        const publicToggle = publicNav?.querySelector<HTMLButtonElement>(".public-menu-toggle");
        const publicNavLinks = document.querySelectorAll<HTMLAnchorElement>(".public-nav-actions a");

        const setCurrentPublicNavLink = () => {
            const currentTarget = window.location.hash || "#inicio";

            publicNavLinks.forEach((link) => {
                const linkUrl = new URL(link.href);
                const isCurrentPath = linkUrl.pathname === window.location.pathname && !linkUrl.hash;
                const isCurrentHash = linkUrl.pathname === window.location.pathname && linkUrl.hash === currentTarget;

                if (isCurrentPath || isCurrentHash) {
                    link.setAttribute("aria-current", "page");
                } else {
                    link.removeAttribute("aria-current");
                }
            });
        };

        setCurrentPublicNavLink();
        window.addEventListener("hashchange", setCurrentPublicNavLink);

        publicToggle?.addEventListener("click", () => {
            const isOpen = publicNav?.classList.toggle("is-open");
            publicToggle.setAttribute("aria-expanded", String(isOpen));
            publicToggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
        });

        publicNavLinks.forEach((link) => {
            link.addEventListener("click", () => {
                publicNav?.classList.remove("is-open");
                publicToggle?.setAttribute("aria-expanded", "false");
                publicToggle?.setAttribute("aria-label", "Abrir menú");
            });
        });
    </script>
