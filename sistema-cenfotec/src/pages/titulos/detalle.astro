            { label: "Nivel", value: "Bachillerato" },
            { label: "Escuela", value: "Tecnologías de Información" },
            { label: "Egresados", value: "342" },
        ]}
        sections={[
            { title: "Datos administrativos", items: [
                { label: "Código interno", value: "TIT-ISW-BAC" },
                { label: "Estado", value: "Activo" },
                { label: "Última revisión", value: "2026-06-20" },
            ] },
        ]}
    />
</Main>
