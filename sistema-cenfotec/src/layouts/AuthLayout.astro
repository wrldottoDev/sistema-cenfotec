---
// Importa los estilos globales para las pantallas públicas de autenticación.
import "../styles/global.css";

// Define el título opcional que puede recibir cada pantalla de autenticación.
interface Props {
    title?: string;
}

// Asigna el título de la pestaña del navegador con un valor por defecto.
const {title = "Sistema CENFOTEC" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <script is:inline>
        // Aplica el tema guardado o la preferencia del sistema antes de mostrar la vista.
        const savedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? "dark" : "light");
    </script>
</head>
<body class="auth-body">
    <slot />
</body>
</html>
